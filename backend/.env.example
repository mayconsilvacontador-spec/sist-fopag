# =========================================================
# SIST - Backend - variáveis de ambiente
# Copie para ".env" e ajuste. NUNCA versione o arquivo .env.
# =========================================================

# --- Django ---
DJANGO_DEBUG=True
# Gere uma chave nova: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados (PostgreSQL obrigatório) ---
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://sist:sist@localhost:5432/sist

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# True = executa tarefas Celery de forma síncrona (útil se não houver Redis em dev)
CELERY_TASK_ALWAYS_EAGER=False

# --- Frontend / CORS ---
# Origens autorizadas a chamar a API diretamente (o frontend usa BFF, mas o
# navegador pode chamar a API em desenvolvimento / documentação)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# IPs dos proxies confiáveis (o BFF Next.js). Apenas requisições vindas destes
# IPs têm o cabeçalho X-Forwarded-For considerado para o IP de auditoria.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=10

# --- Segurança de login ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Receita Federal (Conecta gov.br — API CPF Light) ---
# Credenciais recebidas após a adesão do órgão ao Conecta gov.br. Vazio = consulta desativada.
CONECTA_CLIENT_ID=
CONECTA_CLIENT_SECRET=
# homologacao | producao
CONECTA_AMBIENTE=homologacao

# --- Arquivos ---
MEDIA_ROOT=media

# Chave Fernet para criptografar o certificado do eSocial (gerar com: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ESOCIAL_CERT_KEY=

# Chave Fernet para segredos guardados no banco (chave de API da IA). Gerar como a ESOCIAL_CERT_KEY.
SIST_SECRETS_KEY=
