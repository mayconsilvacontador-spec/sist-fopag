# =========================================================
# SIST - Frontend - variáveis de ambiente
# Copie para ".env.local". Estas variáveis são lidas SOMENTE no servidor
# Next.js (BFF); nenhuma é exposta ao navegador.
# =========================================================

# URL interna do backend Django (sem barra no final)
BACKEND_URL=http://127.0.0.1:8000

# Origens autorizadas a enviar requisições de escrita ao BFF (proteção CSRF)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# true SOMENTE quando houver proxy reverso (nginx/IIS) na frente do Next.js
# definindo X-Real-IP / X-Forwarded-For. Caso contrário o IP enviado pelo
# navegador poderia ser falsificado.
TRUST_PROXY_HEADERS=false

# Cookies "Secure" (exigem HTTPS). Use true em produção.
COOKIE_SECURE=false
